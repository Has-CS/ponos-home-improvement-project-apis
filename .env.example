APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default is "log" (mail bodies write to storage/logs/laravel.log, nothing is
# actually sent) — fine for headless testing. For local testing where you want
# to actually see the emails, use a Mailtrap sandbox inbox instead: create one at
# mailtrap.io -> Inboxes -> your inbox -> SMTP Settings, then swap in your own
# host/username/password below (never commit real credentials here):
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_SCHEME=smtp
#   MAIL_USERNAME=your-mailtrap-username
#   MAIL_PASSWORD=your-mailtrap-password
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT auth (php-open-source-saver/jwt-auth). Leave JWT_SECRET blank and run
# `php artisan jwt:secret` to generate one per environment — never commit a real value.
JWT_SECRET=
JWT_TTL=60               # access token lifetime, minutes
JWT_REFRESH_TTL=20160    # refresh window, minutes (14 days)
JWT_ALGO=HS256

# Password reset link. IMPORTANT: PASSWORD_RESET_URL/FRONTEND_URL must point at
# your separate FRONTEND app's "set new password" page, NOT this API. The emailed
# link is `{PASSWORD_RESET_URL}?token=...&email=...`; the frontend reads those
# query params and then calls POST {this API}/api/v1/auth/change-password with
# the user's new password. There is no API-only equivalent of this link, since a
# bare URL can't carry a password the user hasn't typed yet — a form step is
# always required somewhere. For local backend-only testing (no frontend running),
# leave MAIL_MAILER=log and pull the token out of storage/logs/laravel.log instead
# of following the link, then POST directly to /api/v1/auth/change-password.
PASSWORD_RESET_TTL=60
PASSWORD_RESET_URL=http://localhost:3000/reset-password
FRONTEND_URL=http://localhost:3000

# Welcome email sent when an admin creates a user. WELCOME_LOGIN_URL should
# point at your frontend app's login page. GENERATED_PASSWORD_LENGTH controls
# the length of the random password generated for the new account.
WELCOME_LOGIN_URL=http://localhost:3000/login
GENERATED_PASSWORD_LENGTH=16
